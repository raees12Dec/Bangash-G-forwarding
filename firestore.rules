rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Authorized staff: the owner email, or any user whose UID has a doc in /admins/{uid}
    // (add staff UIDs manually in the Firebase console -> Firestore -> admins).
    function isAuthorized() {
      return isSignedIn() && (
        request.auth.token.email == 'raeesdec12@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // The app stores all ERP data in this single consolidated document.
    match /erp_cloud_data/{documentId} {
      allow read, write: if isAuthorized();
    }

    // Connection check used by the app at startup (read-only, signed-in users)
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
